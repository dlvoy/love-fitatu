# Copy this file to scripts/.env and fill it in. scripts/.env is git-ignored; never commit it.
# One KEY=value per line. Values are taken literally (no variable expansion); surrounding
# single or double quotes are removed.

# Path to the keystore (.jks). Absolute, or relative to this scripts/ folder.
KEYSTORE_PATH=C:/path/to/love-fitatu-release.jks

# Keystore password.
KEYSTORE_PASSWORD=change-me

# Alias of the key inside the keystore.
KEY_ALIAS=love-fitatu

# Key password (same as the keystore password for a PKCS12 keystore).
KEY_PASSWORD=change-me

# Optional: JDK 17+ to build with. When unset, JAVA_HOME from the environment is used, or
# Android Studio's bundled JDK if that one is missing or older than 17.
# JAVA_HOME=C:/Program Files/Android/Android Studio/jbr

# Optional: serial of the device to use when more than one is connected (see `adb devices`).
# ANDROID_SERIAL=
